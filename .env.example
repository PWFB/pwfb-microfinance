# PWFB Microfinance environment reference

DATABASE_URL=postgresql://username:password@localhost:5432/pwfb
JWT_SECRET=replace-with-a-long-random-production-secret
NEXT_PUBLIC_API_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://pwfb-frontend.onrender.com

# Google Identity Services
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_ORIGINS=http://localhost:3000,https://pwfb-frontend.onrender.com
GOOGLE_ANDROID_CLIENT_ID=your-android-server-client-id.apps.googleusercontent.com

# WebAuthn / Fingerprint / Passkey
WEBAUTHN_RP_NAME=PWFB Microfinance
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3000,https://pwfb-frontend.onrender.com
WEBAUTHN_ANDROID_ORIGINS=android:apk-key-hash:REPLACE_WITH_RELEASE_CERTIFICATE_HASH

# Paystack
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_DVA_PREFERRED_BANK=titan-paystack
PAYSTACK_DVA_REQUIRE_IDENTITY=true

# Flutterwave - only for existing PWFB integrations
FLUTTERWAVE_CLIENT_ID=replace_me
FLUTTERWAVE_CLIENT_SECRET=replace_me
FLUTTERWAVE_API_BASE_URL=https://developersandbox-api.flutterwave.com
FLUTTERWAVE_SECRET_KEY=replace_me
FLW_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=replace_me
FLUTTERWAVE_CALLBACK_URL=https://pwfb-frontend.onrender.com/staff/add
FLUTTERWAVE_VIRTUAL_ACCOUNT_BANK_CODE=090567

# BALMZ AI - server-side only
OPENAI_API_KEY=replace_me
BALMZ_AI_MODEL=gpt-5.6-luna
BALMZ_AI_VISION_MODEL=gpt-5.6-luna
BALMZ_AI_PROVIDER=auto
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.8-flash

NODE_ENV=development
SUPER_ADMIN_EMAIL=admin@pwfb.com
SUPER_ADMIN_PASSWORD=replace_me
AUTHENTICATOR_ENCRYPTION_KEY=replace_with_a_dedicated_random_secret
