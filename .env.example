# ==========================
# PWFB Microfinance
# ==========================

DATABASE_URL=postgresql://username:password@localhost:5432/pwfb
JWT_SECRET=your_super_secure_jwt_secret
NEXT_PUBLIC_API_URL=http://localhost:3000

# Google Identity Services
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_ORIGINS=http://localhost:3000,https://pwfb-microfinance-1.onrender.com,https://pwfb-microfinance-33ne.vercel.app

# WebAuthn / Fingerprint / Passkey
WEBAUTHN_RP_NAME=LAB MICROFINANCE
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3000,https://pwfb-microfinance-1.onrender.com,https://pwfb-microfinance-33ne.vercel.app
VERCEL_FRONTEND_URL=https://pwfb-microfinance-33ne.vercel.app

# Paystack
# Keep the secret key server-side only. Never expose it in the frontend or GitHub.
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
PAYSTACK_BASE_URL=https://api.paystack.co
# Supported DVA providers include wema-bank and titan-paystack.
PAYSTACK_DVA_PREFERRED_BANK=titan-paystack
# Financial-services integrations may require customer identity validation.
PAYSTACK_DVA_REQUIRE_IDENTITY=true
# Staff registration uses Paystack bank-account + BVN identity verification.
# Configure the single unified Paystack webhook to POST to:
# https://YOUR-PWFB-BACKEND-DOMAIN/webhooks/paystack
# This endpoint routes staff BVN identity, customer/staff DVA assignment, branch DVA events and deposits.
# The backend preserves raw request bytes for x-paystack-signature verification.

# Dojah identity verification (BVN and NIN)
# Keep credentials server-side only. Start with sandbox; set DOJAH_ENVIRONMENT=live
# only after live API access and wallet funding have been approved.
DOJAH_ENVIRONMENT=sandbox
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
# Optional override. Defaults to sandbox.dojah.io unless environment is live/production.
# DOJAH_API_BASE_URL=https://sandbox.dojah.io

# Flutterwave
# Retained only for other existing PWFB integrations; NOT used for Staff Registration BVN verification.
FLUTTERWAVE_CLIENT_ID=your-flutterwave-client-id
FLUTTERWAVE_CLIENT_SECRET=your-flutterwave-client-secret
FLUTTERWAVE_API_BASE_URL=https://developersandbox-api.flutterwave.com
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
FLW_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=your-flutterwave-webhook-secret-hash
FLUTTERWAVE_CALLBACK_URL=https://pwfb-microfinance-1.onrender.com/staff/add
FLUTTERWAVE_VIRTUAL_ACCOUNT_BANK_CODE=090567

# BALMZ AI - keep all provider keys server-side only
OPENAI_API_KEY=your-openai-api-key
BALMZ_AI_MODEL=gpt-5.6-luna
BALMZ_AI_VISION_MODEL=gpt-5.6-luna
BALMZ_AI_PROVIDER=auto
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

NODE_ENV=development

SUPER_ADMIN_EMAIL=admin@pwfb.com
SUPER_ADMIN_PASSWORD=change-this-in-render

# PWFB in-app voice calls (optional TURN relay for restrictive NAT/firewalls)
# Audio is peer-to-peer when a direct path is available. If you operate a TURN server,
# configure comma-separated TURN/STUN URLs and the coturn REST shared secret here.
# Never commit a production shared secret. Without TURN, some networks may fail to connect.
# PWFB_TURN_URLS=turn:turn.your-domain.example:3478?transport=udp,turns:turn.your-domain.example:5349?transport=tcp
# PWFB_TURN_SHARED_SECRET=replace-with-private-coturn-rest-shared-secret
