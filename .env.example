# ==========================
# PWFB Microfinance
# ==========================

DATABASE_URL=postgresql://username:password@localhost:5432/pwfb
JWT_SECRET=your_super_secure_jwt_secret
NEXT_PUBLIC_API_URL=http://localhost:3000

# Google Identity Services
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_ORIGINS=http://localhost:3000,https://pwfb-frontend.onrender.com

# WebAuthn / Fingerprint / Passkey
# Production defaults to https://pwfb-frontend.onrender.com when these are not set.
WEBAUTHN_RP_NAME=PWFB Microfinance
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3000,https://pwfb-frontend.onrender.com

# BALMZ AI - keep the API key server-side only
OPENAI_API_KEY=your-openai-api-key
BALMZ_AI_MODEL=gpt-5.6-luna

NODE_ENV=development

SUPER_ADMIN_EMAIL=admin@pwfb.com
SUPER_ADMIN_PASSWORD=change-this-in-render
