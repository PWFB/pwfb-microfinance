<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#075d2a</item>
        <item name="android:navigationBarColor">#075d2a</item>
        <item name="android:statusBarColor">#064a22</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#075D2A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/pwfb_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
