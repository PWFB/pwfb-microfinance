{
  "name": "pwfb-microfinance",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run start:dev --workspace=backend",
    "build": "npm run build --workspace=backend",
    "build:pwfb": "npm run build --workspace=backend",
    "build:frontend": "npm run build --prefix apps/frontend",
    "start:frontend": "npm run start --prefix apps/frontend",
    "start:prod": "npm run start:prod --workspace=backend",
    "test": "npm run test --workspace=backend"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@prisma/client@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.1": true,
    "prisma@7.10.1": true,
    "sharp@0.35.5": true
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "@prisma/engines": "7.10.1",
    "prisma": "7.10.1"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.5",
    "multer": "2.5.0",
    "deepmerge-ts": "8.0.2"
  }
}
